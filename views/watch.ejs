    <!-- ====== Mobile Action Bar JS (standalone, no strict mode) ====== -->
    <script>
    // Chạy sau khi toàn bộ DOM sẵn sàng
    (function initMobActionBar() {

        // ── Helper: delegate click tới desktop button (vẫn hoạt động dù bị hide)
        function tapDesk(id) {
            var el = document.getElementById(id);
            if (el) el.dispatchEvent(new MouseEvent('click', {bubbles:true, cancelable:true}));
        }

        // ── Helper: gắn sự kiện click + touchend để chắc chắn nhận trên mobile
        function on(id, fn) {
            var el = document.getElementById(id);
            if (!el) return;
            el.addEventListener('click', fn);
            el.addEventListener('touchend', function(e) {
                e.preventDefault(); // tránh double-fire
                fn(e);
            }, { passive: false });
        }

        // ── ⁠⏮ Tập trước
        on('mab-prev', function() { tapDesk('btn-prev-episode'); });

        // ── ⁠⏭ Tập tiếp
        on('mab-next', function() { tapDesk('btn-next-episode'); });

        // ── ⁠♡ Yêu thích
        on('mab-fav', function() {
            tapDesk('favoriteMovieBtn');
            var btn = document.getElementById('mab-fav');
            if (!btn) return;
            btn.classList.toggle('mab-active');
            var ic = btn.querySelector('.material-icons-round');
            if (ic) ic.textContent = btn.classList.contains('mab-active') ? 'favorite' : 'favorite_border';
        });

        // ── ⁠➕ Thêm vào danh sách
        on('mab-save', function() { tapDesk('saveMovieBtn'); });

        // ── ⁠⛶ Toàn màn hình — gọi trực tiếp window.aphimFullscreen (global)
        on('mab-fs', function() {
            if (typeof window.aphimFullscreen === 'function') {
                window.aphimFullscreen();
            } else {
                // Fallback: dispatch toi mpbFs nếu IIFE chưa chạy xong
                var mpbFsEl = document.getElementById('mpbFs');
                if (mpbFsEl) mpbFsEl.dispatchEvent(new MouseEvent('click', {bubbles:true, cancelable:true}));
            }
        });

        // ── ⁠↗ Chia sẻ
        on('mab-share', function() {
            if (typeof shareMovie === 'function') shareMovie();
        });
        // Fallback: gắn lại onclick cho nút share nếu có
        var shareBtn = document.querySelector('#mob-action-bar button[onclick]');
        // (onclick đã có sẵn trong HTML, không cần thêm)

        // ── ⁠⋮ Menu ···
        var moreBtn  = document.getElementById('mab-more-btn');
        var moreMenu = document.getElementById('mab-more-menu');
        if (moreBtn && moreMenu) {
            function toggleMore(e) {
                e.stopPropagation();
                moreMenu.classList.toggle('open');
            }
            moreBtn.addEventListener('click', toggleMore);
            moreBtn.addEventListener('touchend', function(e) {
                e.preventDefault();
                toggleMore(e);
            }, { passive: false });
            // Đóng khi bấm ra ngoài
            document.addEventListener('click', function() { moreMenu.classList.remove('open'); });
            document.addEventListener('touchend', function() { moreMenu.classList.remove('open'); });
            moreMenu.addEventListener('click', function(e) { e.stopPropagation(); });
            moreMenu.addEventListener('touchend', function(e) { e.stopPropagation(); });
        }

        // ── Tắt đèn (Cinema mode)
        on('mab-cinema', function() {
            tapDesk('cinemaModeBtn');
            var btn = document.getElementById('mab-cinema');
            if (btn) btn.classList.toggle('mab-active');
            if (moreMenu) moreMenu.classList.remove('open');
        });

        // ── Đồng bộ yêu thích từ button gốc
        var origFav = document.getElementById('favoriteMovieBtn');
        var mabFav  = document.getElementById('mab-fav');
        if (origFav && mabFav) {
            new MutationObserver(function() {
                var ic = mabFav.querySelector('.material-icons-round');
                var isActive = origFav.classList.contains('active')
                            || origFav.querySelector('.text-red-500, [data-active]');
                if (ic && isActive) { ic.textContent = 'favorite'; mabFav.classList.add('mab-active'); }
                else if (ic) { ic.textContent = 'favorite_border'; mabFav.classList.remove('mab-active'); }
            }).observe(origFav, { attributes: true, childList: true, subtree: true });
        }

    })();
    </script>
    <!-- ====== End Mobile Action Bar JS ====== -->
    <script>
    (function() {
        'use strict';
        // Helper: gửi postMessage tới iframe player
        function msgPlayer(data) {
            var iframe = document.querySelector('#video-container iframe, #player-frame, iframe[src*="player"]');
            if (!iframe) return;
            try { iframe.contentWindow.postMessage(data, '*'); } catch(e) {}
            try { iframe.contentWindow.postMessage(JSON.stringify(data), '*'); } catch(e) {}
        }

        // ── Overlay Controls (bên trong player) ──
        var mpbBack     = document.getElementById('mpbBack');
        var mpbPlay     = document.getElementById('mpbPlay');
        var mpbPlayIcon = document.getElementById('mpbPlayIcon');
        var mpbFwd      = document.getElementById('mpbFwd');
        var mpbPrev     = document.getElementById('mpbPrev');
        var mpbNext     = document.getElementById('mpbNext');
        var mpbFs       = document.getElementById('mpbFs');
        var isPlaying   = false;

        if (mpbBack)  mpbBack.addEventListener('click', function(e){ e.stopPropagation(); msgPlayer({action:'seek',value:-10}); });
        if (mpbFwd)   mpbFwd.addEventListener('click',  function(e){ e.stopPropagation(); msgPlayer({action:'seek',value:10}); });
        if (mpbPlay)  mpbPlay.addEventListener('click', function(e){
            e.stopPropagation();
            isPlaying = !isPlaying;
            mpbPlayIcon.textContent = isPlaying ? 'pause' : 'play_arrow';
            msgPlayer({action: isPlaying ? 'play' : 'pause'});
        });
        if (mpbPrev)  mpbPrev.addEventListener('click', function(e){ e.stopPropagation(); var b=document.getElementById('btn-prev-episode'); if(b)b.click(); });
        if (mpbNext)  mpbNext.addEventListener('click', function(e){ e.stopPropagation(); var b=document.getElementById('btn-next-episode'); if(b)b.click(); });
        if (mpbFs)    mpbFs.addEventListener('click', function(e){
            e.stopPropagation();
            enterOrExitFullscreen();
        });

        // ════ Hàm fullscreen 3 tầng: native → webkit → CSS pseudo ════
        function getPlayerEl() {
            // Chỉ fullscreen phần video, không kèm action bar
            return document.querySelector('#player-and-controls .relative.aspect-video, #player-and-controls > div:first-child') ||
                   document.querySelector('.aspect-video');
        }

        function setFsIcon(isFs) {
            var icon = mpbFs ? mpbFs.querySelector('.material-icons-round') : null;
            var iconDesk = document.querySelector('#fullscreenBtn .material-icons-round');
            var txt = isFs ? 'fullscreen_exit' : 'fullscreen';
            if (icon) icon.textContent = txt;
            if (iconDesk) iconDesk.textContent = txt;
        }

        function exitPseudoFs() {
            var el = document.querySelector('.aphim-pseudo-fs');
            if (el) el.classList.remove('aphim-pseudo-fs');
            document.body.classList.remove('aphim-fs-lock');
            setFsIcon(false);
        }

        function enterPseudoFs(playerEl) {
            playerEl.classList.add('aphim-pseudo-fs');
            document.body.classList.add('aphim-fs-lock');
            setFsIcon(true);
            // ESC hoặc swipe để thoát
            playerEl.addEventListener('touchstart', function handleSwipe(ev) {
                var startY = ev.touches[0].clientY;
                playerEl.addEventListener('touchend', function done(ev2) {
                    playerEl.removeEventListener('touchend', done);
                    if (ev2.changedTouches[0].clientY - startY > 80) { exitPseudoFs(); playerEl.removeEventListener('touchstart', handleSwipe); }
                }, { once: true });
            }, { passive: true });
        }

        function enterOrExitFullscreen() {
            var playerEl = getPlayerEl();
            if (!playerEl) return;

            // Kiểm tra đang pseudo-fs
            if (playerEl.classList.contains('aphim-pseudo-fs')) {
                exitPseudoFs(); return;
            }
            // Kiểm tra đang native fs
            var nativeFs = document.fullscreenElement || document.webkitFullscreenElement;
            if (nativeFs) {
                (document.exitFullscreen || document.webkitExitFullscreen).call(document);
                return;
            }

            // Thử native fullscreen (Android Chrome OK, iOS fail)
            var reqFs = playerEl.requestFullscreen
                     || playerEl.webkitRequestFullscreen
                     || playerEl.mozRequestFullScreen
                     || playerEl.msRequestFullscreen;

            if (reqFs) {
                var p = reqFs.call(playerEl);
                if (p && typeof p.then === 'function') {
                    p.then(function() { setFsIcon(true); })
                     .catch(function() {
                         // Native thất bại (iOS) → dùng CSS pseudo-fs
                         enterPseudoFs(playerEl);
                     });
                } else {
                    // Không có Promise (trình duyệt cũ) → chập nhận
                    setFsIcon(true);
                }
            } else {
                // Không hỗ trợ native fullscreen (iOS Safari) → CSS pseudo-fs
                enterPseudoFs(playerEl);
            }
        }

        // Lắng nghe sự kiện native fullscreenchange để cập nhật icon
        document.addEventListener('fullscreenchange', function() { setFsIcon(!!document.fullscreenElement); });
        document.addEventListener('webkitfullscreenchange', function() { setFsIcon(!!document.webkitFullscreenElement); });

        // ✨ Expose ra global để initMobActionBar gọi được
        window.aphimFullscreen = enterOrExitFullscreen;
        window.aphimSetFsIcon = function(isFs) {
            setFsIcon(isFs);
            // Cập nhật luôn icon trên mab-fs
            var mabFsIcon = document.querySelector('#mab-fs .material-icons-round');
            if (mabFsIcon) mabFsIcon.textContent = isFs ? 'fullscreen_exit' : 'fullscreen';
        };
        // override setFsIcon luôn sync mab-fs
        var _origSetFsIcon = setFsIcon;
        setFsIcon = function(isFs) {
            _origSetFsIcon(isFs);
            var mabFsIcon = document.querySelector('#mab-fs .material-icons-round');
            if (mabFsIcon) mabFsIcon.textContent = isFs ? 'fullscreen_exit' : 'fullscreen';
        };

        // Nút fullscreen desktop (đã có trong #player-control-bar)
        var fullscreenBtnDesk = document.getElementById('fullscreenBtn');
        if (fullscreenBtnDesk) fullscreenBtnDesk.addEventListener('click', function() { enterOrExitFullscreen(); });

        // ── Mobile Action Bar ──
        var mabPrev     = document.getElementById('mab-prev');
        var mabNext     = document.getElementById('mab-next');
        var mabFav      = document.getElementById('mab-fav');
        var mabSave     = document.getElementById('mab-save');
        var mabCinema   = document.getElementById('mab-cinema');
        var mabFsBtn    = document.getElementById('mab-fs');
        var mabMoreBtn  = document.getElementById('mab-more-btn');
        var mabMoreMenu = document.getElementById('mab-more-menu');

        if (mabPrev)  mabPrev.addEventListener('click',  function(){ var b=document.getElementById('btn-prev-episode'); if(b)b.click(); });
        if (mabNext)  mabNext.addEventListener('click',  function(){ var b=document.getElementById('btn-next-episode'); if(b)b.click(); });
        if (mabFav)   mabFav.addEventListener('click',   function(){ var b=document.getElementById('favoriteMovieBtn'); if(b)b.click(); mabFav.classList.toggle('mab-active'); var ic=mabFav.querySelector('.material-icons-round'); if(ic) ic.textContent = mabFav.classList.contains('mab-active') ? 'favorite' : 'favorite_border'; });
        if (mabSave)  mabSave.addEventListener('click',  function(){ var b=document.getElementById('saveMovieBtn'); if(b)b.click(); });
        if (mabCinema)mabCinema.addEventListener('click',function(){ var b=document.getElementById('cinemaModeBtn'); if(b)b.click(); mabCinema.classList.toggle('mab-active'); if(mabMoreMenu) mabMoreMenu.classList.remove('open'); });

        // Nút fullscreen ở action bar (mab-fs) — dùng cùng hàm enterOrExitFullscreen
        if (mabFsBtn) mabFsBtn.addEventListener('click', function(){ enterOrExitFullscreen(); });

        // Cập nhật icon fullscreen cho cả mab-fs
        var _origSetFsIcon = setFsIcon;
        setFsIcon = function(isFs) {
            _origSetFsIcon(isFs);
            var mabFsIcon = mabFsBtn ? mabFsBtn.querySelector('.material-icons-round') : null;
            if (mabFsIcon) mabFsIcon.textContent = isFs ? 'fullscreen_exit' : 'fullscreen';
        };

        // ··· Menu toggle
        if (mabMoreBtn && mabMoreMenu) {
            mabMoreBtn.addEventListener('click', function(e) {
                e.stopPropagation();
                mabMoreMenu.classList.toggle('open');
            });
            // Đóng menu khi click ra ngoài
            document.addEventListener('click', function() {
                if (mabMoreMenu) mabMoreMenu.classList.remove('open');
            });
            mabMoreMenu.addEventListener('click', function(e) { e.stopPropagation(); });
        }

        // ── Đồng bộ tên tập vào cột giữa ──
        function syncEpName() {
            var nameEl = document.getElementById('mab-ep-name');
            if (!nameEl) return;
            // Ưu tiên: nút tập đang active
            var activeEpBtn = document.querySelector('#episode-list button.active');
            if (activeEpBtn) { nameEl.textContent = activeEpBtn.textContent.trim(); return; }
            // Fallback: lấy từ tiêu đề trang
            var titleEl = document.querySelector('.movie-title, h1, [data-movie-title]');
            if (titleEl) { nameEl.textContent = titleEl.textContent.trim().substring(0, 24); }
        }
        // Chạy sau khi JS render episode list xong
        setTimeout(syncEpName, 1200);
        document.addEventListener('episodeChanged', syncEpName); // custom event từ watch.js nếu có

        // ── Đồng bộ trạng thái favorite từ button gốc ──
        document.addEventListener('DOMContentLoaded', function() {
            var origFav = document.getElementById('favoriteMovieBtn');
            if (origFav && mabFav) {
                var obs = new MutationObserver(function() {
                    var isActive = origFav.classList.contains('active') || origFav.querySelector('[data-active]');
                    var ic = mabFav.querySelector('.material-icons-round');
                    if (ic && isActive) { ic.textContent = 'favorite'; mabFav.classList.add('mab-active'); }
                });
                obs.observe(origFav, { attributes: true, childList: true, subtree: true });
            }
        });
    })();
    </script>
    <!-- ====== End Mobile Player Controls JS ====== -->
