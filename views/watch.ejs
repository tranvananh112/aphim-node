<!DOCTYPE html>
<html class="dark" lang="vi">

<head>
    <%- include('partials/head') %>
    <link rel="stylesheet" href="/css/chat-room.css?v=68">
    <link rel="stylesheet" href="/css/chat-mobile-fixed.css?v=66">
    <link rel="stylesheet" href="/css/pwa-safe-area.css?v=3">
    <link rel="stylesheet" href="/css/mobile-viewport-fix.css?v=36">
    <link rel="stylesheet" href="/css/mobile-menu-modern.css?v=38">
    <link rel="stylesheet" href="/css/progressive-image.css?v=13">
    <link rel="stylesheet" href="/css/ambient-bg.css?v=13">
    <link rel="stylesheet" href="/css/avatar-frames.css?v=15">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/lottie-web/5.12.2/lottie.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/hls.js@latest"></script>
    <script src="/js/anti-devtools.js?v=12"></script>

    <!-- 🎬 PREMIUM UNIFIED 3-LAYER DARK THEME (Netflix & YouTube inspired) -->
    <style id="premium-dark-theme-3-layer">
        /* Enforce absolute play button sizing for Chrome/Safari Mobile Lottie */
        #play-btn {
            width: 55px !important;
            height: 55px !important;
            min-width: 55px !important;
            min-height: 55px !important;
            max-width: 55px !important;
            max-height: 55px !important;
            flex-shrink: 0 !important;
            flex-grow: 0 !important;
        }
        #play-btn svg {
            width: 100% !important;
            height: 100% !important;
            max-width: 100% !important;
            max-height: 100% !important;
        }
        @media (min-width: 640px) {
            #play-btn {
                width: 80px !important;
                height: 80px !important;
                min-width: 80px !important;
                min-height: 80px !important;
                max-width: 80px !important;
                max-height: 80px !important;
            }
        }

        /* 📺📱 Seamlessly fuse Video Player and Action Bar universally (both Desktop and Mobile) */
        #player-and-controls > div:first-of-type {
            border-bottom-left-radius: 0px !important;
            border-bottom-right-radius: 0px !important;
            border-bottom-width: 0px !important;
        }
        #mob-action-bar,
        #player-control-bar {
            margin-top: 0px !important;
            border-top-left-radius: 0px !important;
            border-top-right-radius: 0px !important;
            border-top-width: 0px !important;
        }
        /* Mobile: player + action bar = 1 khối đen liền mạch */
        @media (max-width: 767px) {
            #player-and-controls .relative.aspect-video {
                border-bottom-left-radius: 0 !important;
                border-bottom-right-radius: 0 !important;
                border-bottom: none !important;
            }
        }

        /* ── LỚP 1: Nền tổng thể toàn trang (Overall darkest page bg) ── */
        /* Override ambient-bg.css transparent + void fallback */
        html,
        html body,
        html body.bg-background-dark,
        html body.watch-page,
        body.bg-background-dark.watch-page,
        .bg-background-dark,
        main#watchMain {
            background-color: #1e2130 !important;
            background: #1e2130 !important;
        }
        /* Ẩn ambient-bg trên trang watch (đã dùng nền solid) */
        .watch-page .ambient-bg {
            display: none !important;
        }

        /* ── LỚP 2: Khung card chính, Sidebar containers (KHÔNG bao gồm comments-section) ── */
        .bg-layer-2,
        .bg-surface-dark\/50 {
            background-color: #23263a !important;
            background: #23263a !important;
            border: 1px solid rgba(255, 255, 255, 0.08) !important;
            box-shadow: none !important;
        }

        /* ── Comments: div.mt-0 giữ màu nền trang do firebase-comments.js inject ── */
        #comments-section > div {
            background-color: #1e2130 !important;
            background: #1e2130 !important;
            border: 1px solid rgba(255, 255, 255, 0.06) !important;
            box-shadow: none !important;
        }

        /* ── LỚP 3: Các thành phần con bên trong ── */
        .bg-layer-3,
        .comment-item,
        #comments-section div.bg-\[\#323447\],
        #comments-section .bg-\[\#282a3a\],
        .ap-ava-dropdown,
        .ap-dropdown-menu {
            background-color: #1a1d2e !important;
            background: #1a1d2e !important;
            border: 1px solid rgba(255, 255, 255, 0.08) !important;
        }

        .ap-cmt-form-logged {
            background: rgba(30, 33, 42, 0.85) !important;
            border: 1px solid rgba(255, 255, 255, 0.05) !important;
            border-radius: 20px !important;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.15) !important;
            backdrop-filter: blur(12px) !important;
            -webkit-backdrop-filter: blur(12px) !important;
        }

        /* ── Override styles cho từng comment & input bên trong ── */
        .ap-cmt-replies {
            border-left: 2px solid rgba(255, 255, 255, 0.08) !important;
        }
        .ap-cmt-textarea, .ap-cmt-textarea::placeholder, #commentInput::placeholder {
            color: rgba(255, 255, 255, 0.4) !important;
            background: transparent !important;
            border: none !important;
            box-shadow: none !important;
        }
        .ap-form-user-bar {
            background: transparent !important;
            border-bottom: none !important;
        }
        .ap-form-footer-wrap {
            background: rgba(0, 0, 0, 0.15) !important;
            border-top: 1px solid rgba(255, 255, 255, 0.03) !important;
        }
        .ap-spoiler-row, .ap-form-footer {
            border-top: none !important;
        }
        .ap-dropdown-item {
            color: #e5e7eb !important;
            background: transparent !important;
        }
        .ap-dropdown-item:hover {
            background-color: #2e3246 !important;
            background: #2e3246 !important;
        }
        .ap-ep-tag {
            background: rgba(255, 255, 255, 0.05) !important;
            border: 1px solid rgba(255, 255, 255, 0.1) !important;
        }

        /* Cấu trúc lưới Danh sách tập phim (Robust CSS Grid - Style of Image 4) */
        #episode-list {
            display: grid !important;
            grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
            gap: 8px !important;
            width: 100% !important;
            max-height: 350px !important;
            overflow-y: auto !important;
            padding: 0px 6px 12px 8px !important;
            scrollbar-width: thin !important;
            scrollbar-color: rgba(255, 255, 255, 0.15) transparent !important;
        }
        #episode-list::-webkit-scrollbar {
            width: 5px !important;
        }
        #episode-list::-webkit-scrollbar-track {
            background: rgba(255, 255, 255, 0.02) !important;
            border-radius: 10px !important;
        }
        #episode-list::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.15) !important;
            border-radius: 10px !important;
        }
        #episode-list::-webkit-scrollbar-thumb:hover {
            background: #fcd576 !important;
        }
        @media (min-width: 480px) {
            #episode-list {
                grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
            }
        }
        @media (min-width: 640px) {
            #episode-list {
                grid-template-columns: repeat(6, minmax(0, 1fr)) !important;
                gap: 10px !important;
            }
        }
        @media (min-width: 768px) {
            #episode-list {
                grid-template-columns: repeat(8, minmax(0, 1fr)) !important;
            }
        }
        @media (min-width: 1280px) {
            #episode-list {
                grid-template-columns: repeat(8, minmax(0, 1fr)) !important;
            }
        }
        @media (min-width: 1280px) {
            #episode-list {
                grid-template-columns: repeat(9, minmax(0, 1fr)) !important;
            }
        }

        /* Từng nút tập phim (Compact & Uniform Size) */
        #episode-list button {
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
            padding: 4px 4px 8px 4px !important;
            line-height: 1 !important;
            min-width: 0 !important;
            width: 100% !important;
            background-color: #161924 !important;
            background: #161924 !important;
            border: 1px solid rgba(255, 255, 255, 0.05) !important;
            border-radius: 8px !important;
            color: #9ca3af !important;
            font-size: 13px !important;
            font-weight: 500 !important;
            cursor: pointer !important;
            transition: all 0.2s ease-in-out !important;
            white-space: nowrap !important;
            overflow: hidden !important;
            text-overflow: ellipsis !important;
        }
        #episode-list button:hover {
            background-color: rgba(255, 255, 255, 0.05) !important;
            background: rgba(255, 255, 255, 0.05) !important;
            color: #ffffff !important;
            border-color: #ffffff !important;
        }
        #episode-list button.active {
            background-color: #fcd576 !important;
            background: #fcd576 !important;
            color: #000000 !important;
            border-color: transparent !important;
            font-weight: 700 !important;
            box-shadow: 0 4px 12px rgba(252, 211, 77, 0.3) !important;
        }

        /* Sidebar recommendations */
        #recommendations-list > a {
            background-color: #1e2130 !important;
            background: #1e2130 !important;
            border: 1px solid rgba(255, 255, 255, 0.05) !important;
            border-radius: 12px !important;
            overflow: hidden !important;
            transition: all 0.3s ease !important;
        }
        #recommendations-list > a:hover {
            transform: translateY(-4px) !important;
            border-color: rgba(252, 213, 118, 0.3) !important;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4) !important;
        }

        /* ── Thanh điều khiển: ẩn chữ, chỉ giữ icon khi màn dưới 1280px ── */
        @media (max-width: 1280px) {
            #player-control-bar {
                display: flex !important;
                flex-wrap: nowrap !important;
                align-items: center !important;
                justify-content: space-around !important;
                gap: 4px !important;
                padding: 12px 8px !important;
            }
            #player-control-bar button {
                flex: 1 1 auto !important;
                flex-direction: column !important;
                gap: 4px !important;
                padding: 8px 4px !important;
                min-width: 0 !important;
                width: auto !important;
            }
            #player-control-bar button span:last-child {
                display: none !important;
            }
            #player-control-bar button .material-icons-round,
            #player-control-bar button .material-icons {
                font-size: 22px !important;
                margin: 0 !important;
            }
        }

        /* ══════════════════════════════════════════
           MOBILE PLAYER OVERLAY & ACTION BAR
           ══════════════════════════════════════════ */

        /* Overlay controls bên trong video (chỉ mobile) */
        #mob-player-ctrl {
            display: none;
        }
        @media (max-width: 767px) {
            /* Ẩn control bar cũ, thay bằng mobile action bar */
            #player-control-bar {
                display: none !important;
            }
            /* Overlay bên dưới iframe – luôn hiển thị trên mobile */
            #mob-player-ctrl {
                display: flex;
                flex-direction: column;
                gap: 5px;
                position: absolute;
                bottom: 0; left: 0; right: 0;
                z-index: 10;
                background: linear-gradient(to top, rgba(0,0,0,0.92) 0%, rgba(0,0,0,0.55) 60%, transparent 100%);
                padding: 6px 10px 8px;
                pointer-events: none; /* cho click xuyên qua iframe phần trên */
            }
            #mob-player-ctrl > * {
                pointer-events: auto; /* nhưng controls thì click được */
            }
            /* Seekbar */
            .mpb-bar {
                width: 100%;
                height: 3px;
                background: rgba(255,255,255,0.25);
                border-radius: 3px;
                position: relative;
                cursor: pointer;
            }
            .mpb-fill {
                position: absolute;
                left: 0; top: 0;
                height: 100%;
                width: 30%;
                background: #fcd576;
                border-radius: 3px;
            }
            .mpb-dot {
                position: absolute;
                right: -5px; top: -4px;
                width: 11px; height: 11px;
                background: #fcd576;
                border-radius: 50%;
                box-shadow: 0 0 6px rgba(252,213,118,0.8);
            }
            /* Controls row */
            .mpb-row {
                display: flex;
                align-items: center;
                gap: 2px;
            }
            .mpb-btn {
                background: none;
                border: none;
                color: #fff;
                padding: 5px 6px;
                cursor: pointer;
                display: flex;
                align-items: center;
                justify-content: center;
                border-radius: 6px;
                -webkit-tap-highlight-color: transparent;
            }
            .mpb-btn:active { background: rgba(255,255,255,0.12); }
            .mpb-btn .material-icons-round { font-size: 22px; }
            .mpb-btn.sm .material-icons-round { font-size: 19px; color: rgba(255,255,255,0.8); }
            .mpb-time {
                font-size: 10px;
                color: rgba(255,255,255,0.75);
                margin: 0 2px;
                font-variant-numeric: tabular-nums;
                white-space: nowrap;
            }
            .mpb-spacer { flex: 1; }

            /* ══ Mobile Action Bar — 1 hàng cinema style ══ */
            #mob-action-bar {
                display: flex !important;
                flex-direction: row;
                align-items: center;
                justify-content: space-between;
                background: #0d0d0d;
                border: none;
                border-radius: 0 0 12px 12px;
                padding: 6px 12px;
                min-height: 48px;
                position: relative;
                z-index: 99999;
            }
            /* Nhóm trái: prev + next */
            .mab-left {
                display: flex;
                align-items: center;
                gap: 2px;
            }
            /* Ngăn cách */
            .mab-sep {
                width: 1px;
                height: 22px;
                background: rgba(255,255,255,0.15);
                margin: 0 8px;
                flex-shrink: 0;
            }
            /* Nhóm phải: fav + save + share + fs + more */
            .mab-right {
                display: flex;
                align-items: center;
                gap: 0;
                flex: 1;
                justify-content: space-around;
            }
            /* Ẩn cột giữa (tên tập) — không dùng nữa */
            .mab-mid { display: none; }
            /* Button chung — icon TRẮNG, click được trên mobile */
            .mab-btn {
                background: none;
                border: none;
                color: #ffffff;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 6px 8px;
                cursor: pointer;
                border-radius: 8px;
                -webkit-tap-highlight-color: transparent;
                touch-action: manipulation;   /* loại bỏ 300ms tap delay */
                pointer-events: auto;          /* đảm bảo nhận touch */
                transition: opacity 0.15s, transform 0.12s;
            }
            .mab-btn:active { opacity: 0.5; transform: scale(0.88); }
            .mab-btn.mab-active { color: #fcd576 !important; }
            /* Tất cả icon đồng bộ 22px */
            .mab-btn .material-icons-round { font-size: 22px; }

            /* Overflow menu — popup khi nhấn ··· */
            #mab-more-menu {
                display: none;
                position: absolute;
                bottom: calc(100% + 6px);
                right: 0;
                background: #1a1a1a;
                border: 1px solid rgba(255,255,255,0.15);
                border-radius: 12px;
                box-shadow: 0 8px 32px rgba(0,0,0,0.7);
                z-index: 9999;
                min-width: 160px;
                padding: 6px 0;
                overflow: hidden;
            }
            #mab-more-menu.open { display: block; }
            .mab-more-item {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 11px 16px;
                color: #ffffff;
                font-size: 13px;
                font-weight: 500;
                border: none;
                background: none;
                width: 100%;
                text-align: left;
                cursor: pointer;
                -webkit-tap-highlight-color: transparent;
                transition: background 0.14s;
            }
            .mab-more-item:active { background: rgba(255,255,255,0.1); }
            .mab-more-item .material-icons-round { font-size: 19px; color: rgba(255,255,255,0.6); }
            /* Wrapper chứa more btn + menu */
            #mab-more-wrap {
                position: relative;
            }
        }
        /* Ẩn mob-action-bar trên desktop */
        @media (min-width: 768px) {
            #mob-action-bar { display: none !important; }
        }

        /* ══════════════════════════════════════════
           CSS PSEUDO-FULLSCREEN (iOS Safari safe)
           ══════════════════════════════════════════ */

        /* Khi tôi fullscreen bằng CSS (fallback cho iOS) */
        .aphim-pseudo-fs {
            position: fixed !important;
            top: 0 !important; left: 0 !important;
            width: 100vw !important;
            height: 100dvh !important; /* dvh = dynamic viewport height, iOS-aware */
            z-index: 2147483647 !important; /* MAX int — trên tất cả mọi thứ */
            border-radius: 0 !important;
            border: none !important;
            margin: 0 !important;
            background: #000 !important;
            overflow: hidden !important;
        }
        /* iframe bên trong phải fill hết */
        .aphim-pseudo-fs iframe {
            width: 100% !important;
            height: 100% !important;
            border: none !important;
        }
        /* Overlay controls khi pseudo-fs: hiện luôn, rõ hơn */
        .aphim-pseudo-fs #mob-player-ctrl {
            display: flex !important;
            opacity: 1 !important;
        }
        /* Nút thoát pseudo-fs nổi bật */
        .aphim-pseudo-fs #mpbFs .material-icons-round {
            color: #fcd576 !important;
        }
        /* Khoá scroll của body khi pseudo-fs */
        body.aphim-fs-lock {
            overflow: hidden !important;
            position: fixed !important;
            width: 100% !important;
        }
    </style>

    <style>
        /* ══════════════════════════════════════════════════════
           WATCH PAGE MOBILE: CHỐNG LỆCH NGANG (Horizontal Scroll Fix)
           Cố định 2 bên, không cho trang shift trái/phải khi scroll
           ══════════════════════════════════════════════════════ */
        @media (max-width: 1279px) {
            /* Main container: cứng 2 bên */
            main#watchMain,
            #watchMain > *,
            #video-container,
            #sidebar-col,
            #comments-section,
            #mobile-recommendations {
                max-width: 100% !important;
                width: 100% !important;
                overflow-x: hidden !important;
                box-sizing: border-box !important;
            }

            /* Grid container: giữ trong viewport */
            #watchMain > .grid {
                max-width: 100vw !important;
                overflow-x: hidden !important;
            }

            /* Player wrapper: giữ trong khung */
            #player-and-controls,
            #player-and-controls > *,
            .relative.aspect-video {
                max-width: 100% !important;
                overflow-x: hidden !important;
            }

            /* Control bar: không được rộng hơn viewport */
            #player-control-bar {
                max-width: 100% !important;
                overflow-x: hidden !important;
            }

            /* Episode list: clip overflow */
            #episode-list {
                max-width: 100% !important;
                overflow-x: hidden !important;
            }

            /* Gallery: cho phép scroll ngang nhưng không làm lệch trang */
            #movie-gallery-container {
                max-width: 100% !important;
                overflow-x: hidden !important;
            }
            #movie-gallery-scroll {
                /* gallery scroll nội bộ vẫn hoạt động */
                max-width: 100%;
            }

            /* Sidebar + recommendations: không bị tràn */
            #sidebar-col > * {
                max-width: 100% !important;
                overflow-x: hidden !important;
            }

            /* Breadcrumb: không wrap sai */
            #watch-breadcrumb {
                max-width: 100% !important;
                overflow-x: hidden !important;
                white-space: nowrap;
                text-overflow: ellipsis;
            }
        }
    </style>
    <script src="https://unpkg.com/@lottiefiles/dotlottie-wc@0.9.14/dist/dotlottie-wc.js" type="module"></script>
</head>

<body class="bg-background-dark text-gray-100 font-display min-h-screen flex flex-col watch-page overflow-x-hidden w-full">
    <%- include('partials/header') %>

    <main class="flex-grow max-w-[1600px] mx-auto w-full px-4 sm:px-6 lg:px-8 pt-24 pb-8" id="watchMain">
        <!-- Breadcrumbs -->
        <div class="flex items-center gap-2 text-sm text-gray-400 mb-4 font-medium" id="watch-breadcrumb">
            <a class="hover:text-white transition-colors" href="/">Trang chủ</a>
            <span class="material-icons-round text-base">chevron_right</span>
            <span id="breadcrumb-movie-name" class="text-white font-semibold"><%= movie ? movie.name : 'Đang tải...' %></span>
        </div>

        <style>
            @media (min-width: 1280px) {
                #video-container { grid-column: 1 / 9 !important; grid-row: 1 !important; }
                #sidebar-col { grid-column: 9 / 13 !important; grid-row: 1 / 3 !important; }
                #comments-section { grid-column: 1 / 9 !important; grid-row: 2 !important; margin-top: 0 !important; }
                #mobile-recommendations { display: none !important; }
            }
            @media (max-width: 1279px) {
                #video-container { order: 1 !important; }
                #sidebar-col { order: 2 !important; width: 100% !important; overflow: hidden !important; }
                #mobile-recommendations { order: 3 !important; width: 100% !important; }
                #comments-section { order: 4 !important; width: 100% !important; }
            }
        </style>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-6 items-start">
            
            <!-- CỘT TRÁI (Chiếm ~70% - lg:col-span-8) -->
            <div id="video-container" class="lg:col-span-8 flex flex-col gap-5 min-w-0 transition-all duration-300">
                <!-- Player & Controls Integrated Wrapper -->
                <div id="player-and-controls" class="w-full flex flex-col transition-all duration-300">
                    <!-- Video Player -->
                    <div class="relative w-full aspect-video bg-black rounded-xl overflow-hidden shadow-2xl group border border-white/10">
                        <img alt="Video thumbnail" class="w-full h-full object-cover opacity-60"
                            src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" />
                        <div class="absolute inset-0 flex items-center justify-center">
                            <button id="play-btn"
                                class="w-20 h-20 bg-primary/90 text-black rounded-full flex items-center justify-center transform scale-100 group-hover:scale-110 transition-transform duration-300 hover:bg-white hover:text-primary">
                                <span class="material-icons-round text-5xl ml-2">play_arrow</span>
                            </button>
                        </div>

                        <!-- ═══ MOBILE PLAYER OVERLAY CONTROLS ═══ -->
                        <div id="mob-player-ctrl">
                            <!-- Seekbar -->
                            <div class="mpb-bar" id="mpbBar">
                                <div class="mpb-fill" id="mpbFill"><div class="mpb-dot"></div></div>
                            </div>
                            <!-- Controls row -->
                            <div class="mpb-row">
                                <button class="mpb-btn" id="mpbPrev" aria-label="Tập trước">
                                    <span class="material-icons-round">skip_previous</span>
                                </button>
                                <button class="mpb-btn" id="mpbBack" aria-label="Tua lại 10s">
                                    <span class="material-icons-round">replay_10</span>
                                </button>
