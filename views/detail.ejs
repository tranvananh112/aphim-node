<!DOCTYPE html>
<html class="dark" lang="vi">

<head>
    <%- include('partials/head') %>
    <script src="https://unpkg.com/@lottiefiles/dotlottie-wc@0.9.14/dist/dotlottie-wc.js" type="module"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/lottie-web/5.12.2/lottie.min.js"></script>
</head>

<body class="bg-background-dark text-gray-100 font-display min-h-screen overflow-x-hidden w-full">
    <!-- Ambient Background (7 Orbs for Full Coverage) -->
    <div class="ambient-bg">
        <div class="ambient-orb ambient-orb-1"></div>
        <div class="ambient-orb ambient-orb-2"></div>
        <div class="ambient-orb ambient-orb-3"></div>
        <div class="ambient-orb ambient-orb-4"></div>
        <div class="ambient-orb ambient-orb-5"></div>
        <div class="ambient-orb ambient-orb-6"></div>
        <div class="ambient-orb ambient-orb-7"></div>
        <div class="ambient-noise"></div>
        <div class="ambient-grain"></div>
    </div>
    <!-- Navigation -->
    <%- include('partials/header') %>

    <script>
        const mobileMenuBtn = document.getElementById('mobileMenuBtn');
        const mobileMenu = document.getElementById('mobileMenu');
        if (mobileMenuBtn && mobileMenu) {
            mobileMenuBtn.addEventListener('click', () => {
                mobileMenu.classList.toggle('hidden');
            });
        }
    </script>

    <main class="relative pt-0 min-h-screen pb-20 movie-content-zone overflow-x-hidden w-full max-w-[100vw]">
        <div class="absolute top-0 left-0 w-full h-[100vh] z-0 overflow-hidden">
            <div class="relative w-full h-full bg-[#0d0f1a]">
                <img alt="Background" class="w-full h-full object-cover opacity-80 lg:opacity-100 blur-2xl lg:blur-none transform scale-110 lg:scale-100"
                    src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" fetchpriority="high" />
                <div class="absolute inset-0 bg-black/50 lg:bg-transparent backdrop-gradient"></div>
            </div>
        </div>

        

        <div class="w-full max-w-[1600px] mx-auto px-4 md:px-6 lg:px-8 relative z-10 pt-safe-main">
            <div class="flex items-center gap-2 text-sm text-gray-400 mb-8 font-medium">
                <a class="hover:text-white transition-colors" href="/">Trang chủ</a>
                <span class="material-icons-round text-base">chevron_right</span>
                <span id="breadcrumb-movie-name" class="text-white font-semibold"></span>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-2 sm:gap-4 lg:gap-16 mt-[-40px] lg:mt-0 relative z-10">
                <div class="lg:col-span-4 xl:col-span-3 flex flex-col gap-4 lg:gap-6">
                    <style>
                        .custom-mobile-poster { width: 100%; max-width: 280px; }
                        @media (min-width: 640px) { .custom-mobile-poster { max-width: 320px; } }
                        @media (min-width: 1024px) { .custom-mobile-poster { max-width: none; } }
                    </style>
                    <div
                        class="custom-mobile-poster mx-auto relative aspect-[2/3] rounded-[20px] lg:rounded-2xl overflow-hidden shadow-2xl shadow-black/90 lg:shadow-black/50 group bg-transparent">
                        <img alt="Poster"
                            class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700"
                            src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" fetchpriority="high" />
                        <div id="posterQualityBadge"
                            class="absolute top-4 left-4 text-xs font-bold px-3 py-1 rounded shadow-lg uppercase tracking-wider cinematic-gold-badge">
                            Full HD</div>
                    </div>
                <!-- DESKTOP EPISODES (Hidden on mobile) -->
                    <div class="hidden lg:block w-full mt-2 sm:mt-3">
                        <h2 class="text-xl font-bold text-white mb-4 flex items-center gap-3">
                            <span
                                class="w-1.5 h-6 rounded-full cinematic-gold-bar"></span>
                            Danh sách tập phim
                        </h2>
                        <div id="server-list-desktop" class="flex flex-wrap gap-2 mb-4 w-full"></div>
                        
                        <!-- Thanh tìm kiếm tập phim (Desktop) -->
                        <div id="episode-search-desktop" class="flex items-center gap-2 mb-4 w-full" style="display: none;">
                            <div class="relative w-48 sm:w-56">
                                <svg xmlns="http://www.w3.org/2000/svg" class="absolute top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400" style="left: 10px;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                                </svg>
                                <input type="text" id="search-episode-input-desktop" placeholder="Tìm tập..." class="w-full bg-white/5 border border-white/10 rounded-lg py-2 pr-3 text-sm text-white placeholder-gray-500 focus:outline-none focus:border-[#fcd576]/50 transition-colors" style="padding-left: 32px !important;">
                            </div>
                            <button id="sort-episodes-btn-desktop" class="flex-shrink-0 bg-white/5 border border-white/10 rounded-lg w-[38px] h-[38px] flex items-center justify-center text-gray-400 hover:text-white hover:bg-white/10 transition-colors">
                                <span class="material-icons-round text-[18px]">swap_vert</span>
                            </button>
                        </div>

                        <!-- Sử dụng flex wrap để linh hoạt hoặc grid -->
                        <div class="max-h-[400px] overflow-y-auto custom-scrollbar pr-2 pb-2">
                            <div class="grid grid-cols-2 xl:grid-cols-3 gap-2" id="episodes-desktop">
                                <!-- JS will render episodes here -->
                            </div>
                        </div>
                    </div>
                </div>

                <div class="lg:col-span-8 xl:col-span-9 flex flex-col justify-start lg:justify-end items-center lg:items-start pb-0 text-center lg:text-left -mt-2 lg:mt-0">
                    <style>
                        .cinematic-gold-title {
                            font-family: 'Space Grotesk', 'Be Vietnam Pro', system-ui, sans-serif !important;
                            font-weight: 900 !important;
                            background: linear-gradient(135deg, #FFFFFF 0%, #FFF4B8 30%, #FCE181 65%, #D69F3D 100%) !important;
                            -webkit-background-clip: text !important;
                            -webkit-text-fill-color: transparent !important;
                            display: inline-block !important;
                            filter: drop-shadow(0 4px 16px rgba(0, 0, 0, 0.95)) drop-shadow(0 2px 6px rgba(214, 159, 61, 0.5)) !important;
                            letter-spacing: 1.5px !important;
                            line-height: 1.15 !important;
                        }
                        .cinematic-sub-title {
                            font-family: 'Space Grotesk', 'Be Vietnam Pro', system-ui, sans-serif !important;
                            font-weight: 800 !important;
                            color: #fcd576 !important;
                            text-shadow: 0 2px 10px rgba(0, 0, 0, 0.9) !important;
                            letter-spacing: 2.5px !important;
                            display: block !important;
                            margin-top: 8px !important;
                        }
                        .cinematic-gold-btn {
                            background: linear-gradient(135deg, #FFEFA6 0%, #FCD576 40%, #D69F3D 100%) !important;
                            color: #0d0f1a !important;
                            font-weight: 900 !important;
                            box-shadow: 0 6px 20px rgba(214, 159, 61, 0.45), inset 0 2px 4px rgba(255, 255, 255, 0.6) !important;
                            border: 1px solid rgba(255, 255, 255, 0.4) !important;
                            text-shadow: 0 1px 1px rgba(255, 255, 255, 0.5) !important;
                            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important;
                        }
                        .cinematic-gold-btn:hover {
                            background: linear-gradient(135deg, #FFF6C8 0%, #FFE08C 40%, #E5AA45 100%) !important;
                            box-shadow: 0 8px 25px rgba(214, 159, 61, 0.65), inset 0 2px 5px rgba(255, 255, 255, 0.8) !important;
                            transform: translateY(-2px) !important;
                        }
                        .cinematic-gold-badge {
                            background: linear-gradient(135deg, #FFEFA6 0%, #FCD576 45%, #D69F3D 100%) !important;
                            color: #0d0f1a !important;
                            font-weight: 900 !important;
                            box-shadow: 0 4px 14px rgba(214, 159, 61, 0.5), inset 0 1px 2px rgba(255, 255, 255, 0.6) !important;
                            border: 1px solid rgba(255, 255, 255, 0.4) !important;
                            letter-spacing: 1px !important;
                        }
                        .cinematic-gold-bar {
                            background: linear-gradient(to bottom, #FFF4B8 0%, #FCD576 50%, #D69F3D 100%) !important;
                            box-shadow: 0 0 12px rgba(252, 213, 118, 0.6), 0 0 4px rgba(214, 159, 61, 0.8) !important;
                            border-radius: 9999px !important;
                        }
                        .cinematic-gold-rating {
                            background: linear-gradient(135deg, rgba(214, 159, 61, 0.2) 0%, rgba(252, 213, 118, 0.1) 100%) !important;
                            color: #fcd576 !important;
                            border: 1px solid rgba(252, 213, 118, 0.4) !important;
                            box-shadow: 0 4px 14px rgba(214, 159, 61, 0.25) !important;
                            font-weight: 800 !important;
                        }
                    </style>
                    <h1 class="mb-3 lg:mb-5 text-center lg:text-left w-full">
                        <span class="sr-only">Xem Phim <%= typeof movie !== 'undefined' && movie && movie.name ? movie.name : 'Đang tải...' %> Vietsub Thuyết Minh Full HD - <%= typeof movie !== 'undefined' && movie && movie.origin_name ? movie.origin_name : '' %></span>
                        <span class="block text-4xl sm:text-5xl lg:text-7xl cinematic-gold-title" aria-hidden="true"><%= typeof movie !== 'undefined' && movie && movie.name ? movie.name : 'Đang tải...' %></span>
                        <span class="text-xl sm:text-3xl lg:text-4xl cinematic-sub-title" aria-hidden="true"><%= typeof movie !== 'undefined' && movie && movie.origin_name ? movie.origin_name : '' %></span>
                    </h1>

                    <div
                        class="movie-info-container flex flex-nowrap justify-center lg:justify-start items-center gap-x-2 md:gap-4 mb-2 md:mb-3 lg:mb-4 text-[11px] sm:text-sm md:text-base text-center lg:text-left overflow-hidden w-full">
                        <span
                            class="flex items-center gap-1 px-3 py-1 rounded-full backdrop-blur-sm cinematic-gold-rating">
                            <span class="material-icons-round text-lg">star</span>
                            8.7/10
                        </span>
                        <span class="text-gray-500">•</span>
                        <span class="text-gray-300 font-medium">2022</span>
                        <span class="text-gray-500">•</span>
                        <span class="text-gray-300 font-medium">45-60 phút/tập</span>
                    </div>

                    <div
                        class="movie-actions-container flex flex-nowrap items-center justify-center lg:justify-start gap-2.5 sm:gap-3.5 lg:gap-4 mt-4 md:mt-6 lg:mt-7 mb-4 md:mb-6 lg:mb-7 w-full">
                        <a href="/watch" id="watchNowBtn"
                            class="group relative px-6 h-12 sm:px-8 sm:h-14 lg:w-auto lg:h-auto lg:px-9 lg:py-4 rounded-full transition-all duration-300 flex items-center justify-center gap-1.5 lg:gap-3 flex-shrink-0 cinematic-gold-btn shadow-xl">
                            <span class="material-icons-round text-[22px] sm:text-[26px] lg:text-[24px]">play_arrow</span>
                            <span class="hidden lg:inline text-base sm:text-lg whitespace-nowrap uppercase tracking-wider font-black">XEM NGAY</span>
                            <span class="lg:hidden text-[14px] sm:text-[16px] whitespace-nowrap ml-1 uppercase font-black tracking-wide">XEM NGAY</span>
                        </a>
                        <button
                            class="w-12 h-12 sm:w-14 sm:h-14 lg:w-auto lg:h-auto lg:px-8 lg:py-4 bg-[#323447] lg:bg-white/10 lg:hover:bg-white/20 text-gray-300 lg:text-white font-semibold rounded-full lg:backdrop-blur-md border border-white/10 lg:border-white/30 lg:hover:border-white/50 transition-all duration-300 flex items-center justify-center gap-0 lg:gap-3 shadow-xl flex-shrink-0 hover:border-[#fcd576]/50">
                            <span class="material-icons-round text-[22px] sm:text-[26px] lg:text-[24px]">videocam</span>
                            <span class="hidden lg:inline text-base whitespace-nowrap">Trailer</span>
                        </button>
                    </div>

                    <!-- MOBILE EPISODES (Hidden on desktop) -->
                    <div class="block lg:hidden w-full mt-1 sm:mt-1.5 mb-3">
                        <h2 class="text-lg font-bold text-white mb-3 flex items-center gap-2">
                            <span class="w-1.5 h-6 rounded-full cinematic-gold-bar"></span>
                            Danh sách tập phim
                        </h2>
                        <div id="server-list-mobile" class="flex flex-nowrap overflow-x-auto gap-2 mb-3 w-full pb-2 hide-scrollbar"></div>
                        
                        <!-- Thanh tìm kiếm tập phim (Mobile) -->
                        <div id="episode-search-mobile" class="flex items-center gap-2 mb-3 w-full px-1" style="display: none;">
                            <div class="relative w-48 sm:w-56">
                                <svg xmlns="http://www.w3.org/2000/svg" class="absolute top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400" style="left: 10px;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                                </svg>
                                <input type="text" id="search-episode-input-mobile" placeholder="Tìm tập..." class="w-full bg-white/5 border border-white/10 rounded-lg py-2 pr-3 text-sm text-white placeholder-gray-500 focus:outline-none focus:border-[#fcd576]/50 transition-colors" style="padding-left: 32px !important;">
                            </div>
                            <button id="sort-episodes-btn-mobile" class="flex-shrink-0 bg-white/5 border border-white/10 rounded-lg w-[38px] h-[38px] flex items-center justify-center text-gray-400 hover:text-white hover:bg-white/10 transition-colors">
                                <span class="material-icons-round text-[18px]">swap_vert</span>
                            </button>
                        </div>

                        <div class="overflow-y-auto custom-scrollbar pr-1.5 pb-2" style="max-height: 260px;">
                            <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-6 gap-2" id="episodes-mobile">
                                <!-- JS will render episodes here -->
                            </div>
                        </div>
                    </div>

                    <div id="movie-content-section" class="mb-8 w-full text-left">
                        <h2 class="text-lg font-bold text-white mb-3 flex items-center gap-2">
                            <span class="w-1.5 h-6 rounded-full cinematic-gold-bar"></span>
                            Nội dung phim
                        </h2>
                        <div id="movie-content"
                            class="text-gray-300 leading-relaxed text-sm md:text-lg font-light text-justify px-2 md:px-0">
                            Đang tải nội dung phim...
                        </div>
                    </div>

                    <!-- THƯ VIỆN HÌNH ẢNH (GALLERY) -->
                    <div id="movie-gallery-container" class="mb-8 max-w-full text-left w-full hidden">
                        <h2 class="text-lg font-bold text-white mb-3 flex items-center gap-2">
                            <span class="w-1.5 h-6 rounded-full cinematic-gold-bar"></span>
                            Hình ảnh <span id="movie-gallery-count" class="text-gray-400 text-sm font-normal ml-1"></span>
                        </h2>
                        <div class="relative w-full group">
                            <!-- Nút Cuộn Trái -->
                            <button id="btn-scroll-left" class="absolute left-0 top-1/2 -translate-y-1/2 z-10 w-10 h-10 bg-black/60 hover:bg-[#d69f3d] rounded-full text-white hover:text-black flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all duration-300 transform -translate-x-1/2 shadow-lg backdrop-blur-sm border border-white/20">
                                <span class="material-icons-round">chevron_left</span>
                            </button>
                            
                            <!-- Container Hình Ảnh (Cuộn ngang) -->
                            <div id="movie-gallery-scroll" class="flex gap-4 overflow-x-auto snap-x snap-mandatory hide-scrollbar pb-2 pt-1 scroll-smooth">
                                <!-- JS Render Images Here -->
                            </div>
                            
                            <!-- Nút Cuộn Phải -->
                            <button id="btn-scroll-right" class="absolute right-0 top-1/2 -translate-y-1/2 z-10 w-10 h-10 bg-black/60 hover:bg-[#d69f3d] rounded-full text-white hover:text-black flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all duration-300 transform translate-x-1/2 shadow-lg backdrop-blur-sm border border-white/20">
                                <span class="material-icons-round">chevron_right</span>
                            </button>
                        </div>
                    </div>
                    
                </div>
            </div>

            
        <!-- Premium ads disabled -->
            <!-- DOM placeholder for Comments & Rating System -->
            <style>
                /* Custom CSS cho Desktop 2-column layout (Dùng Grid để chống sập layout) */
                .ap-comments-layout { display: grid; grid-template-columns: 1fr; width: 100%; gap: 32px; }
                .ap-comments-main { min-width: 0; width: 100%; margin-top: 0; order: 2; }
                .ap-top-sidebar { display: block; width: 100%; margin-top: 0px; overflow: hidden; order: 1; }
                @media (min-width: 1280px) {
                    .ap-comments-layout { grid-template-columns: 1fr 420px; align-items: flex-start; }
                    .ap-comments-main { order: 1; }
                    /* Đồng bộ margin-top: 32px (mt-8) để ngang hàng với div.bg-[#282a3a] của bình luận */
                    .ap-top-sidebar { width: 100%; margin-top: 32px; overflow: visible; order: 2; }
                }

                /* ── Comments: div.mt-0 giữ màu nền trang do firebase-comments.js inject ── */
                #comments-section > div {
                    background-color: #1e2130 !important;
                    background: #1e2130 !important;
                    border: 1px solid rgba(255, 255, 255, 0.06) !important;
                    box-shadow: none !important;
                }
                /* Remove old .ap-cmt-wrapper background override */
                .comment-item,
                #comments-section div.bg-\[\#323447\],
                #comments-section .bg-\[\#282a3a\],
                .ap-ava-dropdown,
                .ap-dropdown-menu {
                    background-color: #1a1d2e !important;
                    background: #1a1d2e !important;
                    border: 1px solid rgba(255, 255, 255, 0.08) !important;
                }
            </style>
            <div class="ap-comments-layout">
            <!-- Cột trái: Bình luận -->
            <div id="comments-section" class="ap-comments-main mb-8">
                <div class="mt-0 bg-[#1e2130] border border-white/5 rounded-2xl p-4 md:p-8 text-white w-full">
                    <h2 class="text-xl md:text-2xl font-bold mb-6 flex items-center gap-3 text-white">
                        <span class="material-icons-round text-primary outline-none">sentiment_satisfied_alt</span>
                        Bình luận
                    </h2>

                    <!-- Tabs: Bình luận / Đánh giá -->
                    <div class="flex gap-2 mb-6">
                        <button
                            class="px-6 py-2 rounded-full text-sm transition-colors cinematic-gold-btn">
                            Bình luận
                        </button>
                        <button
                            class="px-6 py-2 bg-white/5 hover:bg-white/10 text-white font-semibold rounded-full text-sm transition-colors">
                            Đánh giá
                        </button>
                    </div>

                    <!-- Login prompt -->
                    <p class="text-gray-400 text-sm mb-6">
                        Bạn có thể không <span
                            class="text-[#fcd576] font-bold cursor-pointer hover:underline"
                            onclick="if(window.showAuthModal)window.showAuthModal('login')">đăng nhập</span> để tham gia bình luận.
                    </p>

                    <!-- Comment Form -->
                    <div class="space-y-4 border border-white/10 rounded-xl p-4 md:p-6 bg-[#252836]">
                        <textarea id="commentInput"
                            class="w-full bg-transparent border-none text-gray-300 placeholder-gray-500 focus:ring-0 resize-none"
                            rows="3" placeholder="Viết bình luận"></textarea>
                        <div class="text-right text-xs text-gray-500 mb-4">0 / 1000</div>

                        <div class="space-y-4">
                            <div>
                                <label class="block text-gray-400 text-sm mb-1">Tên của bạn</label>
                                <input type="text"
                                    class="w-full bg-[#1e2130] border border-white/10 rounded-lg p-3 text-white focus:border-[#fcd576] focus:ring-1 focus:ring-[#fcd576]"
                                    placeholder="Tên của bạn">
                            </div>
                            <div>
                                <label class="block text-gray-400 text-sm mb-1">Email</label>
                                <input type="email"
                                    class="w-full bg-[#1e2130] border border-white/10 rounded-lg p-3 text-white focus:border-[#fcd576] focus:ring-1 focus:ring-[#fcd576]"
                                    placeholder="Email (không bắt buộc)">
                            </div>
                        </div>

                        <div class="mt-4 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
                            <div class="flex items-center gap-4">
                                <label class="flex items-center cursor-pointer">
                                    <div class="relative">
                                        <input type="checkbox" class="sr-only">
                                        <div class="block bg-gray-600 w-10 h-6 rounded-full"></div>
                                        <div
                                            class="dot absolute left-1 top-1 bg-white w-4 h-4 rounded-full transition transform">
                                        </div>
                                    </div>
                                    <div class="ml-3 text-gray-400 text-sm">Tiết lộ?</div>
                                </label>
                                <button
                                    class="flex items-center gap-2 text-sm text-gray-400 bg-black/40 px-3 py-1.5 rounded-full border border-white/10">
                                    <span class="w-4 h-4 rounded-full bg-gray-600"></span>
                                    Ảnh đại diện
                                </button>
                            </div>
                        </div>

                        <button id="submitRating"
                            class="mt-6 w-full flex items-center justify-center gap-2 py-3 rounded-full transition-all cinematic-gold-btn">
                            GỬI
                            <span class="material-icons-round text-sm">play_arrow</span>
                        </button>

                        <p class="text-xs text-gray-500 mt-4 text-center">* Không cần đăng nhập. Bình luận vi phạm chính
                            sách sẽ bị xoá.</p>
                    </div>
                </div>
            </div>

            <!-- Cột phải: Top Phim Sidebar -->
            <aside id="top-weekly-sidebar" class="ap-top-sidebar">
                <!-- Nội dung được render từ js/top-weekly-sidebar.js -->
            </aside>
            </div>
        </div>
</main>

    <!-- Footer -->
    <!-- Ads disabled -->
                    <%- include('partials/footer') %>
    <!-- App Guide Popup -->
    <div id="aphim-guide-overlay" onclick="if(event.target===this)aphimCloseGuide()" style="display:none;position:fixed;inset:0;z-index:99999;background:rgba(0,0,0,0.88);backdrop-filter:blur(6px);align-items:center;justify-content:center;padding:16px;">
        <div style="position:relative;width:100%;max-width:460px;background:#0d0f1a;border:1px solid rgba(255,255,255,0.1);border-radius:16px;overflow:hidden;box-shadow:0 24px 60px rgba(0,0,0,0.8);">
            <div style="display:flex;align-items:center;justify-content:space-between;padding:12px 18px;border-bottom:1px solid rgba(255,255,255,0.07);background:rgba(0,0,0,0.25);">
                <span style="font-size:0.82rem;font-weight:800;color:#fff;text-transform:uppercase;letter-spacing:0.06em;">Hướng dẫn cài đặt A Phim</span>
