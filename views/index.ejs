        <!-- Dynamic Category Lottie Icons script -->
        <script>
        (function () {
            // Màu chính cho từng icon (định dạng Lottie normalized 0-1)
            var ICONS = [
                { id: 'lottie-phim-bo',   path: '/icon-phim-bo.json',   color: [1.000, 1.000, 1.000] },  // #FFFFFF
                { id: 'lottie-phim-moi',  path: '/icon-phim-moi.json',  color: [1.000, 1.000, 1.000] },  // #FFFFFF
                { id: 'lottie-hanh-dong', path: '/icon-hanh-dong.json', color: [1.000, 1.000, 1.000] },  // #FFFFFF
                { id: 'lottie-tinh-cam',  path: '/icon-tinh-cam.json',  color: [1.000, 1.000, 1.000] },  // #FFFFFF
                { id: 'lottie-hai-huoc',  path: '/icon-hai-huoc.json',  color: [1.000, 1.000, 1.000] },  // #FFFFFF
                { id: 'lottie-hoat-hinh', path: '/icon-hoat-hinh.json', color: [1.000, 1.000, 1.000] },  // #FFFFFF
            ];

            function initOne(icon) {
                var el = document.getElementById(icon.id);
                if (!el) return;
                fetch(icon.path + '?v=' + Date.now())
                    .then(function (r) { return r.text(); })
                    .then(function (rawText) {
                        var whiteText = rawText.replace(
                            /"k":\[\s*[\d.]+\s*,\s*[\d.]+\s*,\s*[\d.]+\s*,\s*1\s*\]/g,
                            '"k":[1,1,1,1]'
                        );
                        var animData = JSON.parse(whiteText);
                        var anim = lottie.loadAnimation({
                            container: el,
                            renderer: 'svg',
                            loop: false,
                            autoplay: true,
                            animationData: animData
                        });
                        anim.addEventListener('complete', function () {
                            setTimeout(function () { anim.goToAndPlay(0, true); }, 1000);
                        });
                    })
                    .catch(function (e) {
                        console.warn('[Lottie] Không tải được:', icon.path, e);
                    });
            }

            function initLottieIcons() {
                if (typeof lottie === 'undefined') { setTimeout(initLottieIcons, 150); return; }
                ICONS.forEach(initOne);
            }

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', initLottieIcons);
            } else {
                initLottieIcons();
            }
        })();
        </script>
