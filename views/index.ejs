    <script>
        // Preload critical data on page load
        document.addEventListener('DOMContentLoaded', () => {
            // Start preloading in background
            preloadCriticalData().catch(err => console.warn('Preload error:', err));
        });


        // Fallback function - load Vietnamese movies
        async function loadVietnameseMoviesHome() {
            const grid = document.getElementById('vietnamMoviesGrid');

            // Exit if element doesn't exist on this page
            if (!grid) {
                console.log('Vietnamese movies section not on this page');
                return;
            }

            try {
                const response = await fetch('https://ophim1.com/v1/api/quoc-gia/viet-nam?page=1', {
                    method: 'GET',
                    headers: { 'accept': 'application/json' }
                });

                const data = await response.json();

                if (data.status === 'success' && data.data && data.data.items) {
                    const movies = data.data.items.slice(0, 10);
                    renderVietnameseMovies(movies);
                }
            } catch (error) {
                console.error('Error loading Vietnamese movies:', error);
                const loading = document.getElementById('vietnamLoading');
                if (loading) {
                    loading.innerHTML = `<p class="text-red-400">Không thể tải phim Vi�!t Nam</p>`;
                }
            }
        }

        function renderVietnameseMovies(movies) {
            const loading = document.getElementById('vietnamLoading');
            const grid = document.getElementById('vietnamMoviesGrid');

            // Null check - exit if elements don't exist
            if (!loading || !grid) {
                console.warn('Vietnamese movies section not found on this page');
                return;
            }

            loading.classList.add('hidden');
            grid.classList.remove('hidden');

            // Get movie links from localStorage
            const movieLinks = JSON.parse(localStorage.getItem('movieLinks') || '{}');

            grid.innerHTML = movies.map(movie => {
                const hasCustomLink = !!movieLinks[movie.slug];
                const linkUrl = hasCustomLink ? `/xem-phim/${movie.slug}` : `/phim/${movie.slug}`;
                const hiddenUI = window.getHiddenMovieOverlay ? window.getHiddenMovieOverlay(movie.slug) : { badge: '', imgClass: '', containerClass: '' };

                const thumb = movie.thumb_url || '';
                const poster = movie.poster_url || '';

