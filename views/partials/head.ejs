<% if (typeof structuredData !== 'undefined' && structuredData) { %>
<script type="application/ld+json">
<%- structuredData %>
</script>
<% } else if (typeof movie !== 'undefined' && movie) { %>
<!-- Fallback -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "<%= movie.type === 'series' ? 'TVSeries' : 'Movie' %>",
  "name": "<%= movie.name ? movie.name.replace(/\"/g, '&quot;') : '' %>",
  "alternateName": "<%= movie.origin_name ? movie.origin_name.replace(/\"/g, '&quot;') : '' %>",
  "image": "<%= typeof ogImage !== 'undefined' ? ogImage : (movie.thumb_url ? (movie.thumb_url.startsWith('http') ? movie.thumb_url : 'https://img.ophimimg.com/' + (movie.thumb_url.startsWith('uploads/') ? '' : 'uploads/movies/') + movie.thumb_url) : 'https://aphim.top/android-chrome-512x512.png') %>",
  "description": "<%= typeof metaDescription !== 'undefined' ? metaDescription.replace(/\"/g, '&quot;') : (movie.name || '') %>",
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "<%= (Math.random() * (4.9 - 4.5) + 4.5).toFixed(1) %>",
    "bestRating": "5",
    "ratingCount": "<%= Math.floor(Math.random() * (25000 - 8000) + 8000) %>"
  }
}
</script>
<% } %>


<script src="/js/voice-search.js?v=60" defer></script>
