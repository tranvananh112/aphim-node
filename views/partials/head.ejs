    <script>
        window.renderMovieBadges = function(lang, episode) {
            let epText = String(episode || '').replace(/[^0-9]/g, '');
            if (!epText && String(episode || '').toLowerCase().includes('full')) epText = 'Full';
            if (!epText) epText = 'HD';
            
            let badgesHTML = '';
            const langStr = String(lang || 'Vietsub').toLowerCase();
            
            if (langStr.includes('vietsub') || langStr.includes('phụ đề') || langStr === 'hd') {
                badgesHTML += `<span class="badge-pd">PĐ. ${epText}</span>`;
            }
            if (langStr.includes('thuyết minh')) {
                badgesHTML += `<span class="badge-tm">TM. ${epText}</span>`;
            }
            if (langStr.includes('lồng tiếng')) {
                badgesHTML += `<span class="badge-lt">LT. ${epText}</span>`;
            }
            
            if (!badgesHTML) {
                badgesHTML += `<span class="badge-pd">${lang} ${epText}</span>`;
            }
            return `<div class="ranking-badges-bottom">${badgesHTML}</div>`;
        };

        window.renderModernPagination = function(curPage, totalPgs, functionCallPattern) {
            if (totalPgs <= 1) return '';
            
            const prevDisabled = curPage <= 1 ? 'disabled style="opacity:0.3;cursor:not-allowed;background-color:#24283b;"' : '';
            const nextDisabled = curPage >= totalPgs ? 'disabled style="opacity:0.3;cursor:not-allowed;background-color:#24283b;"' : '';
            
            const prevCall = functionCallPattern.replace(/PAGE/g, curPage - 1);
            const nextCall = functionCallPattern.replace(/PAGE/g, curPage + 1);
            const inputCallPattern = functionCallPattern.replace(/PAGE/g, 'this.value');
            
            return `
            <div class="flex justify-center items-center w-full mt-4 mb-6">
                <div class="flex items-center gap-4 md:gap-6">
                    <button onclick="${prevDisabled ? '' : prevCall}" class="w-12 h-12 md:w-14 md:h-14 flex-shrink-0 rounded-full flex items-center justify-center transition-colors shadow-sm" style="background-color: #24283b;" onmouseover="if(!this.disabled) this.style.backgroundColor='#31364a'" onmouseout="if(!this.disabled) this.style.backgroundColor='#24283b'" ${prevDisabled}>

                        <span class="material-icons-round text-gray-400 text-xl md:text-2xl">arrow_back</span>
                    </button>

                    <div class="h-12 md:h-14 rounded-full px-4 md:px-6 flex items-center justify-center gap-3 md:gap-4 shadow-sm" style="background-color: #31364a;">
                        <span class="text-white text-[15px] md:text-[17px] font-medium whitespace-nowrap">Trang</span>
                        <div class="flex items-center gap-2">
                            <input type="number" 
                                   value="${curPage}" 
                                   min="1" max="${totalPgs}"
                                   class="bg-transparent border border-gray-500 rounded-md text-center text-[#f2f20d] text-[16px] md:text-[18px] font-bold focus:border-[#f2f20d] focus:outline-none focus:ring-1 focus:ring-[#f2f20d]"
                                   style="width: 3.5rem; height: 2.2rem; -moz-appearance: textfield;"
                                   onkeypress="if(event.key === 'Enter') { this.blur(); }"
                                   onchange="let p = parseInt(this.value); if(p >= 1 && p <= ${totalPgs} && p !== ${curPage}) { ${functionCallPattern.replace(/PAGE/g, 'p')} } else { this.value = ${curPage}; }"
                                   title="Nhập số trang và nhấn Enter">
                            <span class="text-gray-400 mx-1">/</span>
                            <span class="text-gray-400">${totalPgs}</span>
                        </div>
                    </div>
                    <button onclick="${nextDisabled ? '' : nextCall}" class="w-12 h-12 md:w-14 md:h-14 flex-shrink-0 rounded-full flex items-center justify-center transition-colors shadow-sm" style="background-color: #24283b;" onmouseover="if(!this.disabled) this.style.backgroundColor='#31364a'" onmouseout="if(!this.disabled) this.style.backgroundColor='#24283b'" ${nextDisabled}>
                        <span class="material-icons-round text-gray-400 text-xl md:text-2xl">arrow_forward</span>
                    </button>
                </div>
            </div>`;
        };
    </script>
