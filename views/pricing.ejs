    <script>
        // -- Sync pricing from backend settings ----------------------------------
        (async function syncPricing() {
            function fmtVND(num) {
                if (!num || isNaN(num)) return null;
                return Number(num).toLocaleString('vi-VN');
            }
            function applyPrices(payment) {
                const premium = fmtVND(payment?.pricePremium);
                const premiumYear = fmtVND(payment?.pricePremiumYear);
                if (premium) {
                    const el = document.getElementById('price-premium');
                    if (el) el.textContent = premium;
                }
                if (premiumYear) {
                    const el = document.getElementById('price-premium-year');
                    if (el) el.textContent = premiumYear;
                }
            }
            try {
                const BACKEND = (typeof API_CONFIG !== 'undefined')
                    ? API_CONFIG.BACKEND_URL
                    : (location.hostname === 'localhost' ? 'http://localhost:5000/api' : 'https://a-phim-production-f6a2.up.railway.app/api');
                const paymentRes = await fetch(`${BACKEND}/settings/payment-public`);
                if (paymentRes.ok) {
                    const data = await paymentRes.json();
                    if (data?.success && data?.data) {
                        applyPrices(data.data);
                        try {
                            const cached = JSON.parse(localStorage.getItem('cinestream_public_settings') || '{}');
                            Object.assign(cached, data.data);
                            localStorage.setItem('cinestream_public_settings', JSON.stringify(cached));
                        } catch (e) { }
                    }
                }
            } catch (e) {
                console.warn('Pricing sync failed, using defaults', e);
            }

            window.openPaymentModal = function (planId) {
                window.location.href = `/payment?plan=${planId}`;
            };

            // Tab Switching Logic
            window.switchPricingTab = function (tab) {
                const planSec = document.getElementById('planSection');
                const coinSec = document.getElementById('coinSection');
                const bg = document.getElementById('pricingToggleBg');
                const btnPlan = document.getElementById('togglePlanBtn');
                const btnCoin = document.getElementById('toggleCoinBtn');
                if (tab === 'plan') {
                    coinSec.style.opacity = '0';
                    setTimeout(() => {
                        coinSec.style.display = 'none';
                        planSec.style.display = 'block';
                        void planSec.offsetWidth;
                        planSec.style.opacity = '1';
                    }, 150);
                    bg.style.transform = 'translateX(0)';
                    btnPlan.style.color = '#000';
                    btnCoin.style.color = '#9ca3af';
                } else {
                    planSec.style.opacity = '0';
                    setTimeout(() => {
                        planSec.style.display = 'none';
                        coinSec.style.display = 'block';
                        void coinSec.offsetWidth;
                        coinSec.style.opacity = '1';
                    }, 150);
                    bg.style.transform = 'translateX(100%)';
                    btnCoin.style.color = '#000';
                    btnPlan.style.color = '#9ca3af';
                }
            };

            // Auto-switch based on URL params
            const urlParams = new URLSearchParams(window.location.search);
            if (urlParams.get('tab') === 'coin') {
                const planSec = document.getElementById('planSection');
                const coinSec = document.getElementById('coinSection');
                const bg = document.getElementById('pricingToggleBg');
                const btnPlan = document.getElementById('togglePlanBtn');
                const btnCoin = document.getElementById('toggleCoinBtn');
                if (planSec && coinSec) {
                    planSec.style.display = 'none';
                    planSec.style.opacity = '0';
                    coinSec.style.display = 'block';
                    coinSec.style.opacity = '1';
                    bg.style.transform = 'translateX(100%)';
                    btnCoin.style.color = '#000';
                    btnPlan.style.color = '#9ca3af';
                }
            }
        })();
    </script>

